1️⃣ Assign Cookies — LeetCode #455
import java.util.*;

class Solution {
    public int findContentChildren(int[] g, int[] s) {

        Arrays.sort(g);
        Arrays.sort(s);

        int child = 0;

        for (int cookie : s) {

            if (child < g.length && cookie >= g[child]) {
                child++;
            }
        }

        return child;
    }
}

Time: O(n log n + m log m)
Space: O(1) extra

2️⃣ Jump Game — LeetCode #55 ⭐⭐⭐
class Solution {
    public boolean canJump(int[] nums) {

        int farthest = 0;

        for (int i = 0; i < nums.length; i++) {

            if (i > farthest) {
                return false;
            }

            farthest = Math.max(
                farthest,
                i + nums[i]
            );

            if (farthest >= nums.length - 1) {
                return true;
            }
        }

        return true;
    }
}

Example:

nums = [2,3,1,1,4]
Output = true
🧠 Idea

Every position-la maximum reachable index maintain pannuvom.

3️⃣ Gas Station — LeetCode #134 ⭐⭐⭐
class Solution {
    public int canCompleteCircuit(int[] gas, int[] cost) {

        int totalGas = 0;
        int totalCost = 0;

        int tank = 0;
        int start = 0;

        for (int i = 0; i < gas.length; i++) {

            totalGas += gas[i];
            totalCost += cost[i];

            tank += gas[i] - cost[i];

            if (tank < 0) {
                start = i + 1;
                tank = 0;
            }
        }

        return totalGas >= totalCost ? start : -1;
    }
}
